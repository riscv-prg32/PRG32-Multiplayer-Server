{
  "name": "@prg32/multiplayer-server",
  "version": "1.0.0",
  "description": "WebSocket multiplayer relay for PRG32 consoles",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "lint": "npm run lint:syntax && npm run lint:format",
    "lint:syntax": "node --check src/*.js test/*.js examples/*.js",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run lint && npm test",
    "example:client": "node examples/client.js",
    "check:connection": "node examples/check-connection.js"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "dns-packet": "^5.6.1",
    "multicast-dns": "^7.2.5",
    "prettier": "^3.3.3"
  },
  "license": "MIT",
  "private": true
}
